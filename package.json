{
  "name": "openchamber-zhongnan-gym",
  "version": "0.1.1",
  "description": "终南健身人数记录与本地走势预测",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "format": "biome check --write src scripts tests package.json tsconfig.json",
    "lint": "biome check src scripts tests package.json tsconfig.json",
    "verify": "bun run check && bun run lint && bun test && bun run build && bun scripts/verify-manifest.ts && bun scripts/verify-host.ts"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.7.0",
    "@biomejs/biome": "^2.4.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3",
    "zod": "4.3.6"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.0"
    },
    "id": "zhongnan-gym",
    "name": "终南健身",
    "icon": "icon.svg",
    "contributes": {
      "panel": {
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "panel/index.html",
        "title": "终南健身",
        "height": 280
      },
      "service": {
        "entry": "service/main.cjs",
        "runtime": "host",
        "keepRunning": true
      }
    }
  }
}
